*.binlog
msbuild.log
run_out*.log
run_err*.log

# ---------- Python / UAV modülü ----------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
.Python
*.egg-info/
.pytest_cache/

# Python / çalışma logları
*.log
uav_module.log

# EasyOCR önbelleği
.EasyOCR/

# ---------- Veritabanı ----------
*.mdf
*.ldf
*.db
*.db-shm
*.db-wal

# ---------- İşletim sistemi ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editör ----------
.idea/
*.swp
*~

