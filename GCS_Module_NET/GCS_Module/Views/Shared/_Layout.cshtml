<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SVT GCS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        /* TEMA DEĞİŞKENLERİ */
        :root[data-theme="light"] {
            --bg-body: #f4f7f6;
            --bg-card: #ffffff;
            --text-main: #212529;
            --nav-bg: #1a1d23;
            --border: #dee2e6;
        }

        :root[data-theme="dark"] {
            --bg-body: #0f111a;
            --bg-card: #161b22;
            --text-main: #f0f6fc;
            --nav-bg: #010409;
            --border: #30363d;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            transition: all 0.3s ease;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* NAVBAR TASARIMI */
        .navbar {
            background-color: var(--nav-bg) !important;
            border-bottom: 1px solid var(--border);
            padding: 0.8rem 0;
        }

        .navbar-brand {
            font-weight: 800;
            color: #0d6efd !important;
            text-transform: uppercase;
        }

        /* TEMA DEĞİŞTİRME BUTONU (FIXED) */
        .theme-toggle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: 2px solid #0d6efd;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: 0.3s;
            position: relative;
        }

        /* Güneş ve Ay İkon Renk Zorlaması */
        #themeIcon {
            font-size: 1.3rem;
            transition: 0.3s;
        }

        /* Işık modunda ikon rengi */
        [data-theme="light"] #themeIcon {
            color: #f39c12 !important;
        }

        /* Karanlık modda ikon rengi */
        [data-theme="dark"] #themeIcon {
            color: #ffca28 !important;
        }

        .theme-toggle:hover {
            background-color: rgba(13, 110, 253, 0.1);
            transform: scale(1.1);
        }

        /* KARTLAR VE TABLOLAR */
        .card {
            background-color: var(--bg-card);
            border: 1px solid var(--border);
            color: var(--text-main);
        }

        .footer {
            background-color: var(--bg-card);
            color: #8b949e;
            border-top: 1px solid var(--border);
        }

        /* HARİTA KARANLIK MOD FİLTRESİ */
        [data-theme="dark"] .leaflet-tile {
            filter: brightness(0.6) invert(1) contrast(3) hue-rotate(200deg) saturate(0.3) brightness(0.7);
        }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shield-shaded me-2"></i>SVT GCS
                </a>

                <div class="ms-auto d-flex align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-light me-3">
                            <i class="bi bi-person-circle me-1"></i>
                            @User.FindFirst("FullName")?.Value
                            <span class="badge bg-primary ms-1">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline me-2">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-box-arrow-right"></i> Çıkış
                            </button>
                        </form>
                    }
                    <button class="theme-toggle" id="themeToggle" title="Temayı Değiştir">
                        <i class="bi bi-sun-fill" id="themeIcon"></i>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-3 mt-5">
        <div class="container text-center">
            <small>&copy; 2026 - <b>Secure-Vision Telemetry</b> - İHA Yer Kontrol İstasyonu</small>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const htmlElement = document.documentElement;

        // Sayfa yüklendiğinde hafızadaki temayı uygula
        const savedTheme = localStorage.getItem('svt-theme') || 'light';
        applyTheme(savedTheme);

        themeToggle.addEventListener('click', () => {
            const currentTheme = htmlElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';
            applyTheme(newTheme);
        });

        function applyTheme(theme) {
            htmlElement.setAttribute('data-theme', theme);
            localStorage.setItem('svt-theme', theme);

            // İkonu değiştir
            if (theme === 'dark') {
                themeIcon.className = 'bi bi-moon-stars-fill';
                console.log("🌙 Karanlık Mod Aktif");
            } else {
                themeIcon.className = 'bi bi-sun-fill';
                console.log("☀️ Aydınlık Mod Aktif");
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>