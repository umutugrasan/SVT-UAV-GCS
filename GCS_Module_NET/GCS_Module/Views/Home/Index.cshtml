@{
    ViewData["Title"] = "Dashboard";
}


<!-- ============================================================ -->
<!-- UAV SEÇİCİ -->
<!-- ============================================================ -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-airplane-engines text-primary me-2" style="font-size: 1.5rem;"></i>
                        <span class="fw-bold me-3">Aktif UAV'lar:</span>
                        <div class="btn-group btn-group-sm" role="group" id="uavSelector">
                            <button type="button" class="btn btn-primary active" data-uav="all">
                                <i class="bi bi-grid-3x3-gap"></i> Tümü
                            </button>
                        </div>
                    </div>
                    <div>
                        <span class="badge bg-success me-2" id="activeUavCount">
                            <i class="bi bi-broadcast"></i> 0 UAV Bağlı
                        </span>
                        <span class="badge bg-info" id="totalDataCount">
                            <i class="bi bi-database"></i> 0 Veri
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 1. Dinamik Tehdit Eşiği Arayüzü -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body py-2">
                <div class="row align-items-center">
                    <div class="col-md-3">
                        <h6 class="mb-0 text-danger fw-bold">
                            <i class="bi bi-shield-exclamation"></i> Tehdit Analiz Eşiği
                        </h6>
                    </div>
                    <div class="col-md-7">
                        <input type="range" class="form-range" id="threatThresholdRange" min="1" max="10" value="3">
                    </div>
                    <div class="col-md-2 text-end">
                        <span class="badge bg-danger fs-6" id="thresholdDisplay">3 Araç</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 1. Plaka ekleme kısmı -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body py-2">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center flex-grow-1">
                        <h6 class="mb-0 text-danger fw-bold me-3">
                            <i class="bi bi-file-text"></i> Aranan Plakalar
                        </h6>
                        <div class="input-group input-group-sm me-3" style="max-width: 300px;">
                            <input type="text" class="form-control" id="newPlateInput" placeholder="Örn: 34ABC12">
                            <button class="btn btn-danger" type="button" onclick="addWantedPlate()">
                                <i class="bi bi-plus-lg"></i> Ekle
                            </button>
                        </div>
                    </div>

                    <div class="d-flex align-items-center">
                        <small class="text-muted me-2">Aktif Liste:</small>
                        <div id="wantedListBadges">
                            <span class="badge bg-secondary">Liste Boş</span>
                        </div>
                        <button class="btn btn-outline-danger btn-sm ms-3" onclick="clearWantedList()">
                            <i class="bi bi-trash"></i> Temizle
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-12">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> TESPİT EDİLEN ARANAN ARAÇLAR</h6>
                <button class="btn btn-sm btn-light text-danger" onclick="clearThreatLog()">
                    <i class="bi bi-eraser"></i> Temizle
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                    <table class="table table-striped table-hover mb-0 text-center align-middle">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Zaman</th>
                                <th>İHA</th>
                                <th>Plaka</th>
                                <th>Görsel Kanıt</th>
                            </tr>
                        </thead>
                        <tbody id="threatLogBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ============================================================ -->
<!-- TELEMETRY WIDGET'LARI (Üst Panel) -->
<!-- ============================================================ -->
<div class="row mb-3">
    <!-- Batarya Gauge -->
    <div class="col-md-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-3">
                <div class="gauge-container">
                    <svg viewBox="0 0 100 60" class="gauge-svg">
                        <path d="M10,50 A40,40 0 0,1 90,50" fill="none" stroke="#e0e0e0" stroke-width="8" stroke-linecap="round" />
                        <path id="batteryArc" d="M10,50 A40,40 0 0,1 90,50" fill="none" stroke="#28a745" stroke-width="8" stroke-linecap="round" stroke-dasharray="0, 126" />
                    </svg>
                    <div class="gauge-value">
                        <i class="bi bi-battery-charging"></i>
                        <span id="batteryValue">--%</span>
                    </div>
                </div>
                <small class="text-muted">Batarya</small>
            </div>
        </div>
    </div>

    <!-- İrtifa Göstergesi -->
    <div class="col-md-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-3">
                <div class="altitude-display">
                    <div class="altitude-bar-container">
                        <div class="altitude-bar" id="altitudeBar"></div>
                    </div>
                    <div class="altitude-value">
                        <i class="bi bi-arrows-expand"></i>
                        <span id="altitudeValue">--m</span>
                    </div>
                </div>
                <small class="text-muted">İrtifa</small>
            </div>
        </div>
    </div>

    <!-- Hız Göstergesi -->
    <div class="col-md-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-3">
                <div class="speed-display">
                    <div class="speedometer">
                        <svg viewBox="0 0 100 60" class="gauge-svg">
                            <path d="M10,50 A40,40 0 0,1 90,50" fill="none" stroke="#e0e0e0" stroke-width="8" stroke-linecap="round" />
                            <path id="speedArc" d="M10,50 A40,40 0 0,1 90,50" fill="none" stroke="#17a2b8" stroke-width="8" stroke-linecap="round" stroke-dasharray="0, 126" />
                        </svg>
                        <div class="gauge-value">
                            <i class="bi bi-speedometer2"></i>
                            <span id="speedValue">--</span>
                        </div>
                    </div>
                </div>
                <small class="text-muted">Hız (km/h)</small>
            </div>
        </div>
    </div>

    <!-- Pusula / Heading -->
    <div class="col-md-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-3">
                <div class="compass-container">
                    <div class="compass">
                        <div class="compass-arrow" id="compassArrow"></div>
                        <div class="compass-labels">
                            <span class="n">N</span>
                            <span class="e">E</span>
                            <span class="s">S</span>
                            <span class="w">W</span>
                        </div>
                    </div>
                    <div class="heading-value">
                        <span id="headingValue">--°</span>
                    </div>
                </div>
                <small class="text-muted">Yön</small>
            </div>
        </div>
    </div>

    <!-- Sinyal Gücü -->
    <div class="col-md-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-3">
                <div class="signal-display">
                    <div class="signal-bars">
                        <div class="signal-bar" id="sig1"></div>
                        <div class="signal-bar" id="sig2"></div>
                        <div class="signal-bar" id="sig3"></div>
                        <div class="signal-bar" id="sig4"></div>
                        <div class="signal-bar" id="sig5"></div>
                    </div>
                    <div class="signal-value">
                        <i class="bi bi-reception-4"></i>
                        <span id="signalValue">--</span>
                    </div>
                </div>
                <small class="text-muted">Sinyal</small>
            </div>
        </div>
    </div>

    <!-- Uçuş Süresi -->
    <div class="col-md-2">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-3">
                <div class="flight-time-display">
                    <i class="bi bi-clock-history display-6 text-primary"></i>
                    <div class="flight-time-value">
                        <span id="flightTimeValue">00:00</span>
                    </div>
                </div>
                <small class="text-muted">Uçuş Süresi</small>
            </div>
        </div>
    </div>
</div>



<!-- ============================================================ -->
<!-- İSTATİSTİK KARTLARI -->
<!-- ============================================================ -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">Toplam Tespit</h6>
                        <h2 class="mb-0" id="totalCount">0</h2>
                    </div>
                    <i class="bi bi-radar" style="font-size: 3rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-danger text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">Tehdit Sayısı</h6>
                        <h2 class="mb-0" id="threatCount">0</h2>
                    </div>
                    <i class="bi bi-exclamation-triangle" style="font-size: 3rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">Ortalama Güven</h6>
                        <h2 class="mb-0"><span id="avgConfidence">0</span>%</h2>
                    </div>
                    <i class="bi bi-bullseye" style="font-size: 3rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-1 opacity-75">Hedef/Dakika</h6>
                        <h2 class="mb-0" id="ratePerMin">0</h2>
                    </div>
                    <i class="bi bi-activity" style="font-size: 3rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CANLI VİDEOAKIŞ PANELİ-->

<div class="card bg-dark text-white shadow-sm h-100">
    <div class="card-header bg-black d-flex justify-content-between align-items-center py-2">
        <h6 class="mb-0 text-uppercase fw-bold text-danger">
            <i class="bi bi-camera-video-fill me-2"></i>CANLI İHA GÖRÜNTÜSÜ
        </h6>
        <span class="badge bg-danger animate-blink">CANLI</span>
    </div>

    <div class="card-body p-0 position-relative" style="height: 400px; background-color: #000; overflow: hidden;">

        <img id="liveVideo"
             src=""
             style="width: 100%; height: 100%; object-fit: contain; display: none;"
             alt="Canlı Yayın" />

        <div id="noSignal" class="d-flex flex-column justify-content-center align-items-center h-100" style="display: flex;">
            <div class="spinner-grow text-danger mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
            <h5 class="text-danger fw-bold">KAMERA SEÇİN</h5>
            <small class="text-white">Görüntülemek için yukarıdan bir UAV seçin</small>
        </div>

    </div>
</div>


<!-- ============================================================ -->
<!-- GÖREV KONTROL BUTONLARI -->
<!-- ============================================================ -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center py-2">
                <div>
                    <span class="text-muted">Görev Durumu:</span>
                    <span class="badge bg-success ms-2" id="missionStatus">AKTİF</span>
                    <span class="ms-3 text-muted">Başlangıç:</span>
                    <span id="missionStartTime">--:--:--</span>
                </div>
                <div>
                    <button class="btn btn-danger me-2" id="btnEndMission">
                        <i class="bi bi-stop-circle"></i> Görevi Bitir
                    </button>
                    <button class="btn btn-primary me-2" id="btnDownloadPdf">
                        <i class="bi bi-file-pdf"></i> PDF Rapor
                    </button>
                    <button class="btn btn-success" id="btnDownloadExcel">
                        <i class="bi bi-file-excel"></i> Excel Rapor
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- ============================================================ -->
<!-- GRAFİKLER -->
<!-- ============================================================ -->
<div class="row mb-4">
    <!-- Hedef Tipi Dağılımı (Pie Chart) -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white py-2">
                <h6 class="mb-0"><i class="bi bi-pie-chart-fill"></i> Hedef Dağılımı</h6>
            </div>
            <div class="card-body">
                <canvas id="targetTypeChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <!-- Zaman Serisi (Line Chart) -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-dark text-white py-2">
                <h6 class="mb-0"><i class="bi bi-graph-up"></i> Tespit Zaman Serisi</h6>
            </div>
            <div class="card-body">
                <canvas id="timeSeriesChart" height="100"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- HARİTA VE TABLO -->
<!-- ============================================================ -->
<div class="row">
    <!-- Harita -->
    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-geo-alt-fill"></i> Canlı GPS Haritası</h5>
                <!-- Filtre Butonları -->
                <div class="btn-group btn-group-sm" role="group" id="mapFilterGroup">
                    <button type="button" class="btn btn-light active" data-filter="all">Tümü</button>
                    <button type="button" class="btn btn-outline-light" data-filter="car">🚗 Araç</button>
                    <button type="button" class="btn btn-outline-light" data-filter="person">🚶 İnsan</button>
                    <button type="button" class="btn btn-outline-light" data-filter="threat">⚠️ Tehdit</button>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="map" style="height: 400px; width: 100%;"></div>
            </div>
        </div>
    </div>

    <!-- Tablo -->
    <div class="col-md-6 mb-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                <h5 class="mb-0"><i class="bi bi-radar"></i> Canlı Hedef Takibi</h5>
                <div>
                    <span id="status" class="badge bg-warning text-dark me-2">Bağlantı Bekleniyor...</span>
                    <select class="form-select form-select-sm d-inline-block w-auto" id="tableFilter">
                        <option value="all">Tüm Hedefler</option>
                        <option value="car">Araçlar</option>
                        <option value="person">İnsanlar</option>
                        <option value="threat">Tehditler</option>
                    </select>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                    <table class="table table-hover align-middle table-sm" id="targetTable">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>UAV</th>
                                <th>ID</th>
                                <th>Zaman</th>
                                <th>Hedef</th>
                                <th>Güven</th>
                                <th>Tehdit</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- TEHDİT ALARM MODAL -->
<!-- ============================================================ -->
<div class="modal fade" id="threatModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill"></i> TEHDİT ALARMI!</h5>
            </div>
            <div class="modal-body text-center py-4">
                <div class="threat-alert-icon mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
                </div>
                <h4 class="text-danger" id="threatMessage">Bölgede yoğun araç hareketi tespit edildi!</h4>
                <p class="text-muted" id="threatDetails">3+ araç aynı bölgede</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="bi bi-check-lg"></i> Anlaşıldı
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet (yerel - internetsiz çalışır) -->
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <script src="~/lib/leaflet/leaflet.js"></script>

    <!-- Chart.js (yerel - internetsiz çalışır) -->
    <script src="~/lib/chartjs/chart.umd.min.js"></script>

    <!-- Panel stilleri (Index.cshtmlden ayrildi) -->
    <link rel="stylesheet" href="~/css/dashboard.css" />

    <!-- Dashboard mantigi (Index.cshtmlden ayrildi) -->
    <script src="~/js/dashboard.js"></script>
    }